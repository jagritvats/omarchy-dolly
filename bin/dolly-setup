#!/usr/bin/env bash
# dolly-setup: optional, idempotent integration steps. Omarchy plugins have no
# install hooks, so run this once after `omarchy plugin add ... --enable`.
#
#   bin/dolly-setup            menu entries + keybind + python deps check
#   bin/dolly-setup --undo     remove what this script added
#
# What it does (each step prints what it touched):
#   1. Adds one "Dolly Screen Recorder" entry (everything else inside it) to
#      ~/.config/omarchy/extensions/omarchy-menu.jsonc under Trigger > Capture
#      (between "// >>> dolly" / "// <<< dolly" markers; your other lines are kept).
#   2. Adds keybinds to ~/.config/hypr/bindings.lua between the same markers
#      (each skipped if already bound): by default SUPER+ALT+R record/stop,
#      SUPER+ALT+P pause, SUPER+ALT+M zoom-here marker, SUPER+ALT+SHIFT+R save
#      replay, SUPER+ALT+N mute mic, SUPER+ALT+L recordings library (change them or
#      switch them off in Settings > Shortcuts); plus a window rule for the live
#      camera bubble.
#   3. Checks the packages Dolly needs (python-numpy and python-pillow, wf-recorder
#      where gpu-screen-recorder cannot capture) and offers to install them with
#      omarchy-pkg-add, or a private pip venv for the python ones. Asks only when
#      run in a terminal; otherwise prints the command.
#   4. Makes sure the record button is on the bar (omarchy bar put, where it exists).
# It also links ~/.local/bin/dolly to this plugin's launcher, so `dolly` works in a
# terminal, a script or a coding agent's shell (never replaces something that is not ours).
# Also installs the managed Dolly Screen Recorder application launcher.
# Steps 1, 2, the link and launcher are done by `dolly integration apply` (dolly/integration.py):
# no password, safe to repeat, and Dolly repeats them by itself after an update.
set -euo pipefail
# keep __pycache__ out of the plugin folder (Omarchy reloads the plugin when it changes)
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-${XDG_CACHE_HOME:-$HOME/.cache}/dolly/pycache}"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DOLLY="$ROOT/bin/dolly"
PY="$("$DOLLY" --print-python)"
UNDO=false
[[ ${1:-} == --undo ]] && UNDO=true

# ---- 1 + 2: the menu entry, the hotkeys, the `dolly` command (user files only, no password)
if $UNDO; then
  "$DOLLY" integration undo
  exit 0
fi
"$DOLLY" integration apply

# ---- 3. packages Dolly needs (python-numpy and python-pillow; wf-recorder when
# gpu-screen-recorder cannot capture here, as in VMs). Asks only when someone can
# answer: with stdin or stdout not a terminal (piped, scripted) it prints the command.
MISSING="$("$DOLLY" deps --json 2>/dev/null | "$PY" -c 'import json,sys
try: print(" ".join(json.load(sys.stdin)["packages"]))
except Exception: print("python-numpy python-pillow")' || true)"
if [[ -z $MISSING ]]; then
  echo "packages: everything Dolly needs is installed"
else
  echo "packages: missing $MISSING"
  "$DOLLY" deps 2>/dev/null | sed 's/^/    /' || true
  if command -v omarchy-pkg-add >/dev/null; then INSTALL="omarchy-pkg-add $MISSING"; else INSTALL="sudo pacman -S --needed $MISSING"; fi
  if [[ ${DOLLY_SETUP_YES:-} == 1 ]]; then
    echo "packages: installing ($INSTALL)"
    $INSTALL || echo "packages: not installed; later run: $DOLLY deps --install"
  elif [[ -t 0 && -t 1 ]]; then
    read -r -p "Install them now ($INSTALL)? [Y/n/v = private pip venv for the python ones] " a
    case ${a:-y} in
      [yY]*) $INSTALL ;;
      [vV]*)
        VENV="${XDG_DATA_HOME:-$HOME/.local/share}/dolly/venv"
        "$PY" -m venv "$VENV" && "$VENV/bin/pip" install -q numpy pillow
        echo "python: venv ready ($VENV); bin/dolly uses it automatically" ;;
      *) echo "packages: skipped; later run: $DOLLY deps --install" ;;
    esac
  else
    echo "packages: not asking (no terminal). Install with:"
    echo "    $INSTALL"
    echo "  or: $DOLLY deps --install   (opens a terminal that asks for your password)"
  fi
fi

# ---- 4. the record button on the bar. `omarchy plugin add --enable` places it on
# current Omarchy; where `omarchy bar put` exists this makes sure (it leaves a widget
# that is already there where it is).
if command -v omarchy-bar >/dev/null && omarchy-bar --help 2>&1 | grep -q '^ *put '; then
  if omarchy-bar put io.github.jagritvats.dolly --section right >/dev/null 2>&1; then
    echo "bar: record button on the bar (right section)"
  else
    echo "bar: could not place the record button; try: omarchy bar put io.github.jagritvats.dolly --section right"
  fi
else
  echo "bar: if the record button is missing, enable it: omarchy plugin enable io.github.jagritvats.dolly --section right"
fi
echo
"$DOLLY" doctor || true
