{
  "schemaVersion": 1,
  "id": "io.github.jagritvats.dolly",
  "name": "Dolly: Screen Recorder",
  "version": "0.9.9-beta.3",
  "author": "Jagrit Vats",
  "license": "MIT",
  "description": "Screen recorder for demos, tutorials and screencasts on Omarchy. Records your screen or a window and zooms in on what you type and click; built-in video editor, camera bubble, mic and system audio, keystroke overlay, MP4, GIF and vertical exports, and commands for scripts and coding agents.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Dolly recorder",
    "description": "Record button with live timer; opens the Dolly panel (record, recent recordings, settings).",
    "category": "Capture",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "mode": "window",
      "countdown": 3,
      "fps": "60",
      "keys": true,
      "audioMode": "none",
      "camera": "off",
      "replaySeconds": 60,
      "solidWindows": "auto"
    },
    "schema": [
      {
        "key": "mode",
        "type": "enum",
        "label": "Default capture",
        "options": [
          "screen",
          "window",
          "region"
        ],
        "defaultValue": "window"
      },
      {
        "key": "countdown",
        "type": "integer",
        "label": "Countdown (s)",
        "min": 0,
        "max": 10,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "fps",
        "type": "enum",
        "label": "Capture frame rate",
        "options": [
          "30",
          "60"
        ],
        "defaultValue": "60"
      },
      {
        "key": "keys",
        "type": "boolean",
        "label": "Log shortcuts for the keystroke overlay",
        "defaultValue": true
      },
      {
        "key": "audioMode",
        "type": "enum",
        "label": "Audio (separate tracks)",
        "options": [
          "none",
          "mic",
          "system",
          "both"
        ],
        "defaultValue": "none"
      },
      {
        "key": "camera",
        "type": "enum",
        "label": "Camera bubble",
        "options": [
          "off",
          "edit",
          "live"
        ],
        "defaultValue": "off"
      },
      {
        "key": "replaySeconds",
        "type": "integer",
        "label": "Instant replay length (s)",
        "min": 10,
        "max": 600,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "solidWindows",
        "type": "enum",
        "label": "Solid windows while recording (auto = only with Glassy)",
        "options": [
          "auto",
          "on",
          "off"
        ],
        "defaultValue": "auto"
      }
    ]
  }
}
